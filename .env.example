# --- Server ---
API_PORT=8787
NODE_ENV=development
DATABASE_PATH=./data/lapor-handri.db
UPLOAD_DIR=./uploads

# --- Google OAuth (Admin login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
ALLOWED_EMAIL_DOMAINS=uii.ac.id
# Locks the one-time Super Admin bootstrap (first login when admin_users is
# empty) to this email, so no one else on the domain can self-promote first.
SUPER_ADMIN_BOOTSTRAP_EMAIL=

# --- Session ---
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_MAX_AGE_HOURS=12

# --- Email notifications (optional) ---
# Sends via Gmail SMTP. Requires 2-Step Verification enabled on this account,
# then an App Password generated from Google Account settings (NOT the
# account's real password). Leave both blank to disable email notifications
# entirely — the app logs a warning and skips sending instead of failing.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- Frontend build (optional) ---
APP_URL=http://localhost:3000
